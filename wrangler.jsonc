{
  "name": "juss-protect-me-2",
  "main": "./worker.mjs",
  "compatibility_date": "2026-10-15",
  "kv_namespaces": [
    { "binding": "USERS_KV", "id": "d7c8c098e18b4b78ad9596fc5a9372bf" }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "SHIELD_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.05,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": [
      "SHIELD_SECRET"
    ]
  }
}
